// Prompt Template 도메인 REST API 수동 테스트 (IntelliJ HTTP Client)
//
// content 안의 {{name}}, {{day}}는 이 프로젝트의 HTTP Client 환경변수로 정의되어 있지 않아
// IntelliJ가 치환하지 않고 그대로 전송합니다 — 서버가 실제로 처리하는 앱 자체의 {{변수}}
// placeholder 문법입니다. (만약 IntelliJ에서 "Unresolved variable" 경고가 뜨거나 다른 값으로
// 치환되는 것이 확인되면 알려주세요 — 그 경우 http-client.env.json에 name/day를 존재하지 않는
// 이름으로 바꿔서 회피해야 합니다.)
// 요청 1을 먼저 실행해 "greeting" 템플릿을 등록하세요.
// (이미 등록되어 있다면 요청 1은 409가 뜨는 게 정상입니다 — 요청 3과 같은 상황입니다.)

### 1. 템플릿 등록
POST {{baseUrl}}/api/prompt-templates
Content-Type: application/json

{
  "name": "greeting",
  "content": "안녕 {{name}}님, 오늘은 {{day}}입니다."
}

### 2. 템플릿 렌더링 (변수 치환 확인)
POST {{baseUrl}}/api/prompt-templates/greeting/render
Content-Type: application/json

{
  "variables": {
    "name": "철수",
    "day": "월요일"
  }
}

> {%
client.test("200 OK", function () {
    client.assert(response.status === 200, "expected 200 but got " + response.status);
});
client.test("렌더링 결과 확인", function () {
    client.assert(
        response.body.rendered === "안녕 철수님, 오늘은 월요일입니다.",
        "렌더링 결과가 예상과 다릅니다: " + response.body.rendered
    );
});
%}

### 3. 이미 존재하는 이름으로 등록하면 409
POST {{baseUrl}}/api/prompt-templates
Content-Type: application/json

{
  "name": "greeting",
  "content": "다른 내용"
}

> {%
client.test("409 Conflict", function () {
    client.assert(response.status === 409, "expected 409 but got " + response.status);
});
%}

### 4. 존재하지 않는 템플릿을 렌더링하면 404
POST {{baseUrl}}/api/prompt-templates/unknown-template/render
Content-Type: application/json

{
  "variables": {}
}

> {%
client.test("404 Not Found", function () {
    client.assert(response.status === 404, "expected 404 but got " + response.status);
});
%}

### 5. 변수가 누락되면 400
POST {{baseUrl}}/api/prompt-templates/greeting/render
Content-Type: application/json

{
  "variables": {}
}

> {%
client.test("400 Bad Request", function () {
    client.assert(response.status === 400, "expected 400 but got " + response.status);
});
%}
